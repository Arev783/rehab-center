generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AiSuggestionType {
  EXERCISE_PLAN
  PROGRESS_SUMMARY
  ALERT
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───────── Users ─────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?
  therapistProfile TherapistProfile?
  auditLogs        AuditLog[]

  @@map("users")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime?
  diagnosis   String?
  notes       String?
  consentAi   Boolean   @default(false)
  consentAt   DateTime?
  therapistId String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapist TherapistProfile? @relation(fields: [therapistId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  assignments  ExerciseAssignment[]
  progressLogs ProgressLog[]
  suggestions  AiSuggestion[]

  @@map("patient_profiles")
}

model TherapistProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  specialization String
  bio            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  patients     PatientProfile[]
  appointments Appointment[]
  assignments  ExerciseAssignment[]
  suggestions  AiSuggestion[]

  @@map("therapist_profiles")
}

// ───────── Rooms & Equipment ─────────

model Room {
  id       String  @id @default(cuid())
  name     String  @unique
  capacity Int     @default(1)
  isActive Boolean @default(true)

  appointments Appointment[]

  @@map("rooms")
}

model Equipment {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  bookings AppointmentEquipment[]

  @@map("equipment")
}

// ───────── Scheduling ─────────

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  therapistId String
  roomId      String
  startsAt    DateTime          @db.Timestamptz(3)
  endsAt      DateTime          @db.Timestamptz(3)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient   PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  room      Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)

  equipment AppointmentEquipment[]

  @@index([therapistId, startsAt])
  @@index([patientId, startsAt])
  @@index([roomId, startsAt])
  @@map("appointments")
}

// startsAt/endsAt-ը կրկնվում են միտումնավոր՝ DB-ի exclusion constraint-ի համար
model AppointmentEquipment {
  appointmentId String
  equipmentId   String
  startsAt      DateTime @db.Timestamptz(3)
  endsAt        DateTime @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  equipment   Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([appointmentId, equipmentId])
  @@map("appointment_equipment")
}

// ───────── Exercises ─────────

model Exercise {
  id           String  @id @default(cuid())
  title        String
  description  String
  instructions String?
  bodyArea     String
  difficulty   Int     @default(1)
  videoUrl     String?
  isActive     Boolean @default(true)

  assignments ExerciseAssignment[]

  @@map("exercises")
}

model ExerciseAssignment {
  id               String           @id @default(cuid())
  patientId        String
  therapistId      String
  exerciseId       String
  sets             Int              @default(3)
  reps             Int              @default(10)
  durationMin      Int?
  frequencyPerWeek Int              @default(3)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  status           AssignmentStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())

  patient   PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  exercise  Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  progressLogs ProgressLog[]

  @@index([patientId, status])
  @@map("exercise_assignments")
}

model ProgressLog {
  id           String   @id @default(cuid())
  assignmentId String
  patientId    String
  completedAt  DateTime @default(now())
  painLevel    Int // 0–10
  setsDone     Int?
  repsDone     Int?
  comment      String?

  assignment ExerciseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  patient    PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, completedAt])
  @@map("progress_logs")
}

// ───────── AI ─────────

model AiSuggestion {
  id            String             @id @default(cuid())
  patientId     String
  therapistId   String?
  type          AiSuggestionType
  summary       String
  content       Json
  status        AiSuggestionStatus @default(PENDING)
  therapistNote String?
  reviewedAt    DateTime?
  model         String
  createdAt     DateTime           @default(now())

  patient   PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist TherapistProfile? @relation(fields: [therapistId], references: [id], onDelete: SetNull)

  @@index([therapistId, status])
  @@map("ai_suggestions")
}

// ───────── Audit ─────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
